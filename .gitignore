# Unity-generated state for the repo-root project (this repo root IS the Unity
# project; the package lives under Packages/com.sss13594.light2d/).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Bb]uild/
/[Bb]uilds/
/[Bb]in/
/UserSettings/
/TestResults/

# Autogenerated VS/MD solution and project files
*.csproj
*.csproj.meta
*.unityproj
*.sln
*.sln.meta
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.pidb.meta
*.booproj
sysinfo.txt

# Root-level host logs and test-result XML from batchmode runs
/*.log
/*-results.xml

# Restored NuGet plugins for the embedded editor-automation MCP (tracked folder
# metas are kept; the restored assemblies inside are regenerated on import).
/Assets/Plugins/NuGet/

# Embedded editor-automation MCP host: a separate, unrelated dev tool kept on disk
# (Unity auto-discovers embedded packages under Packages/) but not committed here.
/Packages/com.sss135.editor-automation-mcp/

# Numbered URP global-settings copies that URP regenerates. NEVER the unnumbered
# sentinel Assets/UniversalRenderPipelineGlobalSettings.asset.
/Assets/UniversalRenderPipelineGlobalSettings [0-9]*.asset
/Assets/UniversalRenderPipelineGlobalSettings [0-9]*.asset.meta

# Generated test-runner scenes and package-manager cache settings.
/Assets/InitTestScene*
/ProjectSettings/PackageManagerSettings.asset

# Edit-time-only Light2D obstacle authoring defaults (OQ-S1: NOT committed; the
# in-memory GetOrCreate defaults are the canonical white/black/clear fallback).
/ProjectSettings/Light2DObstacleSettings.asset

# Leftover metas from the former root-as-package layout (root files outside
# Assets/Packages/ProjectSettings are not imported by Unity).
/CLAUDE.md.meta
/[Tt]emp.meta
/[Oo]bj.meta

# Local planning scratch
/.codex/
